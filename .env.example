# Explicitly select only a network you own or are authorized to scan.
NETWORK_CIDR=192.168.1.0/24
SCAN_ENGINE=nmap
SCAN_PROFILE=discovery
SCAN_INTERVAL_SECONDS=300
AUTO_SCAN=true
# Set a long random value if binding the application beyond localhost.
API_TOKEN=
# Optional vendor-neutral JSON file containing observed controller/SNMP/LLDP links.
TOPOLOGY_FILE=
DATABASE_PATH=network_map.db

